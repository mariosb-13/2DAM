<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fitsSystemWindows="true">

    <ToggleButton
        android:id="@+id/toggleModo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:textOff="@string/modo_casual"
        android:textOn="@string/modo_formal"
        android:background="@drawable/toggle_modo_bg"
        android:textColor="@drawable/toggle_modo_text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageButton
        android:id="@+id/imgProfile"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:background="@null"
        android:contentDescription="Perfil"
        android:scaleType="fitCenter"
        android:src="@drawable/usuario"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Switch
        android:id="@+id/switchAccesorios"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/mostrar_accesorios"
        android:textColor="@color/text_dark"
        android:thumbTint="@color/color1"
        android:trackTint="@color/color2"
        app:layout_constraintStart_toStartOf="@id/toggleModo"
        app:layout_constraintTop_toBottomOf="@id/toggleModo"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <HorizontalScrollView
        android:id="@+id/scrollCamisetas"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:scrollbars="none"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/switchAccesorios"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="90dp"
            android:paddingEnd="90dp">

            <ImageButton
                android:id="@+id/imgCamiseta"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:background="@null"
                android:contentDescription="Camiseta"
                android:scaleType="centerInside"
                android:src="@drawable/camiseta_travis"
                android:layout_marginEnd="16dp"/>

            <ImageButton
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:background="@null"
                android:contentDescription="Camiseta 2"
                android:scaleType="centerInside"
                android:src="@drawable/camiseta2"
                android:layout_marginEnd="16dp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/scrollPantalones"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:scrollbars="none"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/scrollCamisetas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="90dp"
            android:paddingEnd="90dp">

            <ImageButton
                android:id="@+id/imgPantalon"
                android:layout_width="180dp"
                android:layout_height="200dp"
                android:background="@null"
                android:contentDescription="Pantalón"
                android:scaleType="centerInside"
                android:src="@drawable/pantalones"
                android:layout_marginEnd="16dp"/>

            <ImageButton
                android:layout_width="180dp"
                android:layout_height="200dp"
                android:background="@null"
                android:contentDescription="Pantalón 2"
                android:scaleType="centerInside"
                android:src="@drawable/nike_pantalones"
                android:layout_marginEnd="16dp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/scrollZapatillas"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:scrollbars="none"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/scrollPantalones"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="90dp"
            android:paddingEnd="90dp">

            <ImageButton
                android:id="@+id/imgZapatilla"
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="16dp"
                android:background="@null"
                android:contentDescription="Zapatilla"
                android:scaleType="centerInside"
                android:src="@drawable/zapatillas_travis" />

            <ImageButton
                android:layout_width="180dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="16dp"
                android:background="@null"
                android:contentDescription="Zapatilla 2"
                android:scaleType="centerInside"
                android:src="@drawable/akimbo" />
        </LinearLayout>
    </HorizontalScrollView>

    <ImageButton
        android:id="@+id/btnAleatorio"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/btn_aleatorio_circular"
        android:contentDescription="@string/desc_aleatorio"
        android:elevation="12dp"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/mezcla"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollZapatillas" />

</androidx.constraintlayout.widget.ConstraintLayout>