<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fitsSystemWindows="true"> <ToggleButton
    android:id="@+id/toggleModo"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginTop="16dp"
    android:textOff="@string/modo_casual"
    android:textOn="@string/modo_formal"
    android:background="@drawable/toggle_modo_bg"
    android:textColor="@drawable/toggle_modo_text"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"/>

    <ImageButton
        android:id="@+id/imgProfile"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:background="@null"
        android:contentDescription="Perfil"
        android:scaleType="fitCenter"
        android:src="@drawable/usuario"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Switch
        android:id="@+id/switchAccesorios"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/mostrar_accesorios"
        android:textColor="@color/text_dark"
        android:thumbTint="@color/color1"
        android:trackTint="@color/color2"
        app:layout_constraintStart_toStartOf="@id/toggleModo"
        app:layout_constraintTop_toBottomOf="@id/toggleModo"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/viewSuperior"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/switchAccesorios"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/imgCamiseta"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:background="@null"
            android:contentDescription="Camiseta"
            android:scaleType="fitCenter"
            android:src="@drawable/camisetas"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/viewInferior"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewSuperior">

        <ImageButton
            android:id="@+id/imgPantalon"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:background="@null"
            android:contentDescription="Pantalón"
            android:scaleType="fitCenter"
            android:src="@drawable/pantalon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/viewZapatillas"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/viewInferior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/imgZapatilla"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:background="@null"
            android:contentDescription="Zapatilla"
            android:scaleType="fitCenter"
            android:src="@drawable/zapatillas"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageButton
        android:id="@+id/btnAleatorio"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/btn_aleatorio_circular"
        android:contentDescription="@string/desc_aleatorio"
        android:elevation="12dp"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/mezcla"
        app:layout_constraintTop_toBottomOf="@id/viewZapatillas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnCambiarOutfit"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="@string/btn_cambiar_outfit"
        android:textAllCaps="false"
        android:backgroundTint="@color/bg_dark"
        android:textColor="@color/text_light"
        app:layout_constraintTop_toBottomOf="@id/btnAleatorio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="1.0"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="48dp"/> </androidx.constraintlayout.widget.ConstraintLayout>