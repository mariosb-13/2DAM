<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="32dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp"
    app:cardBackgroundColor="@android:color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="30dp">

        <TextView
            android:id="@+id/tvHeaderDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_azul_oscuro"
            android:gravity="center"
            android:padding="16dp"
            android:text="DETALLE"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_alignParentTop="true"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardImagen"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_centerHorizontal="true"
            android:layout_below="@id/tvHeaderDialog"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="90dp"
            app:cardElevation="6dp">

            <ImageView
                android:id="@+id/imgDialogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/cart"
                tools:ignore="ContentDescription" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvNombreDialogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/cardImagen"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Flan de Queso"
            android:textColor="@color/color_azul_oscuro"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetalleDialogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvNombreDialogo"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="24dp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:text="Ingredientes..."
            android:textColor="#666666"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/layoutAlergenos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvDetalleDialogo"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iconGluten"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_gluten"
                android:visibility="gone"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/iconLactosa"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_lacteo"
                android:visibility="gone"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/iconHuevo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_huevo"
                android:visibility="gone"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/iconCacahuete"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_frutos"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvPrecioDialogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/layoutAlergenos"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="4.50€"
            android:textColor="@color/color_azul_oscuro"
            android:textSize="30sp"
            android:textStyle="bold" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAgregar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvPrecioDialogo"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:src="@drawable/cart"
            app:backgroundTint="@color/color_azul_medio"
            app:tint="@android:color/white"
            app:fabCustomSize="64dp" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>