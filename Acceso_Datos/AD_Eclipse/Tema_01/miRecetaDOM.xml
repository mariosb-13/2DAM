<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<receta>
    <titulo>Bizcocho casero</titulo>
    <ingredientes>
        <ingrediente>
            <nombre>Harina</nombre>
            <cantidad>200g</cantidad>
        </ingrediente>
        <ingrediente>
            <nombre>Azúcar</nombre>
            <cantidad>100g</cantidad>
        </ingrediente>
        <ingrediente>
            <nombre>Huevos</nombre>
            <cantidad>2 unidades</cantidad>
        </ingrediente>
        <ingrediente>
            <nombre>Leche</nombre>
            <cantidad>250ml</cantidad>
        </ingrediente>
    </ingredientes>
    <procedimiento>Mezcla todos los ingredientes, vierte en un molde y hornea a 180°C durante 30 minutos.</procedimiento>
    <tiempo>45 minutos</tiempo>
</receta>
