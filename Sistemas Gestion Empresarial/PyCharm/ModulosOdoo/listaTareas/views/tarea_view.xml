<odoo>
    <data>
        <record id="action_lista_tareas_tarea" model="ir.actions.act_window">
            <field name="name">Lista de Tareas</field>
            <field name="res_model">msb.lista_tareas.tarea</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_tareas_action"
                  name="Tareas"
                  action="action_lista_tareas_tarea"
                  parent="menu_lista_tareas_root"/>

        <record model="ir.ui.view" id="view_lista_tareas_tarea">
            <field name="name">Lista de Tareas</field>
            <field name="model">msb.lista_tareas.tarea</field>
            <field name="arch" type="xml">
                <list>
                    <field name="tarea"></field>
                    <field name="prioridad"></field>
                    <field name="urgente"></field>
                    <field name="realizada"></field>
                </list>
            </field>
        </record>
    </data>
</odoo>