<odoo>
    <data>
        <record id="action_gestion_reservas_guia_turistico" model="ir.actions.act_window"> 
            <field name="name">Guías turísticos</field>
            <field name="res_model">msb.gestion_reservas.guia_turistico</field>
            <field name="view_mode">list,form</field>
        </record>

        <record model="ir.ui.view" id="view_gestion_reservas_guia_turistico">
            <field name="name">Guías turísticos</field>
            <field name="model">msb.gestion_reservas.guia_turistico</field>
            <field name="arch" type="xml">
                <list>
                    <field name="imagen" widget="image" options="{'size':[64,64]}"/>
                    <field name="nombre"/>
                    <field name="idioma"/>
                    <field name="telefono"/>
                </list>
            </field>
        </record>
    </data>
</odoo>