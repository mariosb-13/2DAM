<odoo>
    <data>
        <record id="action_gestion_reservas_comercial" model="ir.actions.act_window">
            <field name="name">Comercial</field>
            <field name="res_model">msb.gestion_reservas.comercial</field>
            <field name="view_mode">list,form</field>
        </record>

        <record model="ir.ui.view" id="view_gestion_reservas_comercial">
            <field name="name">Lista de Comerciales</field>
            <field name="model">msb.gestion_reservas.comercial</field>
            <field name="arch" type="xml">
                <list>
                    <field name="nombre_apellidos"/>
                    <field name="estado"/>
                </list>
            </field>
        </record>
    </data>
</odoo>