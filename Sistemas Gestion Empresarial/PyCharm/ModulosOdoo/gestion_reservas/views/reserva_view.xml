<odoo>
    <data>
        <record id="action_gestion_reservas_reserva" model="ir.actions.act_window"> 
            <field name="name">Reservas</field>
            <field name="res_model">msb.gestion_reservas.reserva</field>
            <field name="view_mode">list,form</field>
        </record>
        
        

        <record model="ir.ui.view" id="view_gestion_reservas_reserva">
            <field name="name">Lista de reservas</field>
            <field name="model">msb.gestion_reservas.reserva</field>
            <field name="arch" type="xml">
                <list>
                    <field name="turista_id"/>
                    <field name="actividad_id"/>
                    <field name="plazas_reservadas"/>
                    <field name="estado"/>
                    <field name="fecha_compra"/>
                </list>
            </field>
        </record>
    </data>
</odoo>