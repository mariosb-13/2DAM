<odoo>
    <data>
        <record id="action_gestion_reservas_categoria_actividad" model="ir.actions.act_window"> 
            <field name="name">Categorías de Actividades</field>
            <field name="res_model">msb.gestion_reservas.categoria_actividad</field>
            <field name="view_mode">list,form</field>
        </record>

        <record model="ir.ui.view" id="view_gestion_reservas_categoria_actividad">
            <field name="name">Categorías de Actividades</field>
            <field name="model">msb.gestion_reservas.categoria_actividad</field>
            <field name="arch" type="xml">
                <list>
                    <field name="nombre"/>
                    <field name="cantidad_actividades"/>
                    <field name="total_ingresado"/>
                </list>
            </field>
        </record>
    </data>
</odoo>