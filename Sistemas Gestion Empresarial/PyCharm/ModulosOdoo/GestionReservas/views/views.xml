<odoo>
    <record id="view_turista_form" model="ir.ui.view">
        <field name="name">gestor.turista.form</field>
        <field name="model">gestor.turista</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="nombre"/>
                        <field name="email"/>
                        <field name="telefono"/>
                    </group>
                    <notebook>
                        <page string="Historial de Reservas">
                            <field name="reserva_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_turista_list" model="ir.ui.view">
        <field name="name">gestor.turista.list</field>
        <field name="model">gestor.turista</field>
        <field name="arch" type="xml">
            <list>
                <field name="nombre"/>
                <field name="email"/>
                <field name="telefono"/>
            </list>
        </field>
    </record>

    <record id="view_turista_analisis_reservas_list" model="ir.ui.view">
        <field name="name">gestor.turista.analisis.reservas.list</field>
        <field name="model">gestor.turista</field>
        <field name="arch" type="xml">
            <list default_order="total_reservas desc">
                <field name="nombre"/>
                <field name="total_reservas" string="Total Reservas"/>
                <field name="reservas_activas" string="Reservas Activas"/>
                <field name="reservas_canceladas" string="Reservas Canceladas"/>
            </list>
        </field>
    </record>

    <record id="view_turista_analisis_gasto_list" model="ir.ui.view">
        <field name="name">gestor.turista.analisis.gasto.list</field>
        <field name="model">gestor.turista</field>
        <field name="arch" type="xml">
            <list default_order="gasto_total desc">
                <field name="nombre"/>
                <field name="gasto_total" string="Importe Total Gastado"/>
            </list>
        </field>
    </record>

    <record id="view_actividad_form" model="ir.ui.view">
        <field name="name">gestor.actividad.form</field>
        <field name="model">gestor.actividad</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="titulo"/>
                        <field name="fecha"/>
                        <field name="precio"/>
                        <field name="plazas_totales"/>
                        <field name="plazas_disponibles"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_actividad_list" model="ir.ui.view">
        <field name="name">gestor.actividad.list</field>
        <field name="model">gestor.actividad</field>
        <field name="arch" type="xml">
            <list>
                <field name="titulo"/>
                <field name="fecha"/>
                <field name="plazas_disponibles"/>
            </list>
        </field>
    </record>

    <record id="view_reserva_list" model="ir.ui.view">
        <field name="name">gestor.reserva.list</field>
        <field name="model">gestor.reserva</field>
        <field name="arch" type="xml">
            <list decoration-muted="estado == 'cancelada'">
                <field name="turista_id"/>
                <field name="actividad_id"/>
                <field name="fecha_compra"/>
                <field name="plazas_reservadas"/>
                <field name="estado"/>
                <button name="action_cancelar" string="Cancelar" type="object"
                        invisible="estado == 'cancelada'"/>
            </list>
        </field>
    </record>

    <record id="view_reserva_form" model="ir.ui.view">
        <field name="name">gestor.reserva.form</field>
        <field name="model">gestor.reserva</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cancelar" string="Cancelar Reserva" type="object"
                            class="oe_highlight" invisible="estado == 'cancelada'"/>
                    <field name="estado" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="turista_id" readonly="estado == 'cancelada'"/>
                        <field name="actividad_id" readonly="estado == 'cancelada'"/>
                        <field name="plazas_reservadas" readonly="estado == 'cancelada'"/>
                        <field name="fecha_compra" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_reservas" model="ir.actions.act_window">
        <field name="name">Reservas</field>
        <field name="res_model">gestor.reserva</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_turistas" model="ir.actions.act_window">
        <field name="name">Turistas</field>
        <field name="res_model">gestor.turista</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_turista_list"/>
    </record>

    <record id="action_actividades" model="ir.actions.act_window">
        <field name="name">Actividades</field>
        <field name="res_model">gestor.actividad</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_analisis_reservas" model="ir.actions.act_window">
        <field name="name">Top Reservas</field>
        <field name="res_model">gestor.turista</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_turista_analisis_reservas_list"/>
    </record>

    <record id="action_analisis_gasto" model="ir.actions.act_window">
        <field name="name">Top Gasto</field>
        <field name="res_model">gestor.turista</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_turista_analisis_gasto_list"/>
    </record>

    <menuitem id="menu_root" name="Reservas" action="action_reservas"/>

    <menuitem id="menu_turistas" name="Turistas" parent="menu_root" action="action_turistas"/>
    <menuitem id="menu_actividades" name="Actividades" parent="menu_root" action="action_actividades"/>

    <menuitem id="menu_analisis" name="Análisis" parent="menu_root"/>

    <menuitem id="menu_top_reservas" name="Top Reservas" parent="menu_analisis" action="action_analisis_reservas"/>
    <menuitem id="menu_top_gasto" name="Top Gasto" parent="menu_analisis" action="action_analisis_gasto"/>

</odoo>