<odoo>
    <record id="view_actividad_form" model="ir.ui.view">
        <field name="name">msb.gestor.actividad.form</field>
        <field name="model">msb.gestor.actividad</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="titulo"/>
                        <field name="fecha"/>
                        <field name="precio"/>
                        <field name="plazas_totales"/>
                        <field name="plazas_disponibles"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_actividad_list" model="ir.ui.view">
        <field name="name">msb.gestor.actividad.list</field>
        <field name="model">msb.gestor.actividad</field>
        <field name="arch" type="xml">
            <list>
                <field name="titulo"/>
                <field name="fecha"/>
                <field name="plazas_disponibles"/>
                <field name="precio"/>
            </list>
        </field>
    </record>

    <record id="action_actividades" model="ir.actions.act_window">
        <field name="name">Actividades</field>
        <field name="res_model">msb.gestor.actividad</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_actividades" name="Actividades" parent="menu_root" action="action_actividades"/>
</odoo>