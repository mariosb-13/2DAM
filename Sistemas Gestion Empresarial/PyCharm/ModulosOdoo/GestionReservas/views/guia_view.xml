<odoo>
    <record id="view_guia_form" model="ir.ui.view">
        <field name="name">msb.gestor.guia.form</field>
        <field name="model">msb.gestor.guia</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="nombre"/>
                        <field name="idioma"/>
                        <field name="telefono"/>
                        <field name="imagen" widget="image" class="oe_avatar"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_guia_tree" model="ir.ui.view">
        <field name="name">msb.gestor.guia.tree</field>
        <field name="model">msb.gestor.guia</field>
        <field name="arch" type="xml">
            <list>
                <field name="nombre"/>
                <field name="idioma"/>
                <field name="telefono"/>
            </list>
        </field>
    </record>

    <record id="action_guias" model="ir.actions.act_window">
        <field name="name">Guías Turísticos</field>
        <field name="res_model">msb.gestor.guia</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_guias" name="Guías" parent="menu_root" action="action_guias"/>
</odoo>