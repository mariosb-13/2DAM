<odoo>
    <record id="view_categoria_form" model="ir.ui.view">
        <field name="name">msb.gestor.categoria.form</field>
        <field name="model">msb.gestor.categoria</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="nombre"/>
                        <field name="descripcion"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_categoria_tree" model="ir.ui.view">
        <field name="name">msb.gestor.categoria.tree</field>
        <field name="model">msb.gestor.categoria</field>
        <field name="arch" type="xml">
            <list> <field name="nombre"/>
                <field name="descripcion"/>
            </list>
        </field>
    </record>

    <record id="action_categorias" model="ir.actions.act_window">
        <field name="name">Categorías</field>
        <field name="res_model">msb.gestor.categoria</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_categorias" name="Categorías" parent="menu_root" action="action_categorias"/>
</odoo>