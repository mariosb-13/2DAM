package ejercicio1;

import java.io.BufferedWriter;
import java.io.FileNotFoundException;
import java.io.FileWriter;
import java.io.IOException;

public class Ejercicio1Ficheros {
	
	public static void main(String[] args) throws FileNotFoundException {
		try {
			BufferedWriter bw1 = new BufferedWriter(new FileWriter("informatica.txt"));
			int cont=0;
			
			
			
			bw1.close();
		} catch (IOException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}

	}
	
	public static int numEnteros() {
		return 1+(int)(500*Math.random());
	}
	
	public void escribirArchivos() {
		do {
			int numAleatorio=numEnteros();
			bw1.write(numAleatorio + "");
			bw1.newLine();
			cont++;
			
			if (cont==5) {
				bw1 = new BufferedWriter(new FileWriter("ventas.txt"));
				cont=0;
			}
		} while (cont<5);
	}

}
