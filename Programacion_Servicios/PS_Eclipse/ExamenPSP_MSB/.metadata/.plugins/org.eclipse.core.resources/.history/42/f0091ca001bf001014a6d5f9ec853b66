package ejercicio2;

public class Jugador extends Thread{
	int id;
	Arbitro arbitro1;
	
	/**
	 * Constructor de jugador
	 * @param id
	 * @param arbitro1
	 */
	public Jugador(int id, Arbitro arbitro1) {
		this.id = id;
		this.arbitro1 = arbitro1;
	}

	/**
	 * Comprueba si el número que genera el jugador coincide con el del árbitro
	 */
	public void run() {
		arbitro1.adivinarNum(id);
	}
	
	/**
	 * Método que genera el numero aleatorio
	 * @return
	 */
	public int generarAleatorioJugador() {
		return 1+(int)(10*Math.random());
	}
	
	
}
