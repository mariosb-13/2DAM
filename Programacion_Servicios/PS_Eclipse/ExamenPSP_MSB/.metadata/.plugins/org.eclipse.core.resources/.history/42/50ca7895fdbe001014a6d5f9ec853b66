public class Ejercicio1Ficheros {
	
	public static void main(String[] args) throws FileNotFoundException {
		try {
			
			
			
			
		} catch (IOException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}

	}
	
	public static int numEnteros() {
		return 1+(int)(500*Math.random());
	}
	
	public void escribirArchivos(String nombreArhivo) {
			try {
				do {
				BufferedWriter bw1 = new BufferedWriter(new FileWriter(nombreArhivo));
				int numAleatorio=numEnteros();

				int cont=0;
				bw1.write(numAleatorio + "");
				bw1.newLine();
				cont++;
			} while (cont<5);

			} catch (IOException e) {
				// TODO Auto-generated catch block
				e.printStackTrace();
			}
			
			if (cont==5) {
				bw1 = new BufferedWriter(new FileWriter("ventas.txt"));
				cont=0;
			}
		
		bw1.close();
	}

}
