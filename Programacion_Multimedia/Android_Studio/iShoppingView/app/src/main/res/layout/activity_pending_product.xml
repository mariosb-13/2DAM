<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F5F5F5"
    tools:context=".PendingProduct">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTitlePending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Artículos Pendientes"
            android:textAlignment="center"
            android:textSize="24sp"
            android:layout_marginBottom="16dp"
            android:textColor="#444444" />

        <Spinner
            android:id="@+id/spinnerProductPending"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#B0BEC5"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnCancelPending"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:onClick="cancelPending"
                android:text="Cancelar"
                android:backgroundTint="#FF8A65"
                android:textColor="#FFFFFF"
                android:elevation="2dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSavePending"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:onClick="savePending"
                android:text="Guardar"
                android:backgroundTint="#81D4FA"
                android:textColor="#FFFFFF"
                android:elevation="2dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
